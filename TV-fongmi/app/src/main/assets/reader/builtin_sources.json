[
  {
    "bookSourceUrl": "https://www.gutenberg.org",
    "bookSourceName": "Project Gutenberg（公版图书）",
    "searchUrl": "https://www.gutenberg.org/ebooks/search/?query={{key}}",
    "ruleSearch": {
      "bookList": "li.booklink",
      "bookName": "span.title@text",
      "author": "span.subtitle@text",
      "bookUrl": "a.link@attr:href",
      "coverUrl": "img.cover-thumb@attr:src"
    },
    "ruleBookInfo": {
      "intro": "@css:meta[name=\"description\"]@attr:content",
      "coverUrl": "@css:meta[property=\"og:image\"]@attr:content"
    },
    "ruleToc": {
      "chapterList": "a[href$='.txt.utf-8']",
      "chapterName": "@js:'全文'",
      "chapterUrl": "@this@attr:href"
    },
    "ruleContent": { "content": "@plain" }
  }
]