[
  {
    "bookSourceUrl": "https://zh.wikisource.org",
    "bookSourceName": "维基文库（公版图书）",
    "searchUrl": "https://zh.wikisource.org/w/api.php?action=query&list=search&srlimit=20&format=json&origin=*&srsearch={{key}}",
    "ruleSearch": {
      "bookList": "@json:$.query.search",
      "bookName": "@json:$.title",
      "author": "@js:(book.title.indexOf('：')>0)?book.title.split('：')[0]:''",
      "bookUrl": "@js:'https://zh.wikisource.org/wiki/'+encodeURIComponent(book.title)",
      "coverUrl": ""
    },
    "ruleBookInfo": { "intro": "@js:''" },
    "ruleToc": { "chapterName": "@this@text", "chapterUrl": "@this@attr:href" },
    "ruleContent": { "content": ".mw-parser-output" }
  }
]