From 49bbc67eb27ecebc303f089c259f31c030f5ffe4 Mon Sep 17 00:00:00 2001
From: oinsilos <oinsilos@users.noreply.github.com>
Date: Thu, 3 Sep 2026 02:42:40 +0000
Subject: [PATCH] build: unify gradle env across TV-fongmi/legado/MusicFree

- pin AGP 8.13.2 and Kotlin 1.9.24 (jvmTarget 17) for MusicFree
- pin Gradle 8.14.4 wrapper for both MusicFree and TV-fongmi
- drop TV-fongmi AGP 9.3.1 preview, targetSdk 37 -> 36, enable useAndroidX
- make gradlew executable for all three projects
---
 Musicgo-main/android/build.gradle             | 11 +++-
 Musicgo-main/android/gradle.properties        |  1 +
 .../gradle/wrapper/gradle-wrapper.properties  |  2 +-
 Musicgo-main/android/gradlew                  |  0
 Musicgo-main/yarn.lock                        | 50 +++++++++++++++++++
 TV-fongmi/gradle.properties                   |  1 +
 TV-fongmi/gradle/libs.versions.toml           |  4 +-
 .../gradle/wrapper/gradle-wrapper.properties  |  2 +-
 TV-fongmi/gradlew                             |  0
 legado-beta/gradlew                           |  0
 10 files changed, 65 insertions(+), 6 deletions(-)
 mode change 100644 => 100755 Musicgo-main/android/gradlew
 mode change 100644 => 100755 TV-fongmi/gradlew
 mode change 100644 => 100755 legado-beta/gradlew

diff --git a/Musicgo-main/android/build.gradle b/Musicgo-main/android/build.gradle
index f2e38ef..cdedd67 100644
--- a/Musicgo-main/android/build.gradle
+++ b/Musicgo-main/android/build.gradle
@@ -16,9 +16,16 @@ buildscript {
         maven { url 'https://jitpack.io' }
     }
     dependencies {
-        classpath("com.android.tools.build:gradle")
+        classpath("com.android.tools.build:gradle:8.13.2")
         classpath("com.facebook.react:react-native-gradle-plugin")
-        classpath("org.jetbrains.kotlin:kotlin-gradle-plugin")
+        classpath("org.jetbrains.kotlin:kotlin-gradle-plugin:1.9.24")
     }
 }
 apply plugin: "com.facebook.react.rootproject"
+
+// 统一所有自动链接原生模块的 Kotlin 编译目标(与 Java 17 保持一致),避免交叉读取字节码版本错误
+allprojects {
+    tasks.withType(org.jetbrains.kotlin.gradle.tasks.KotlinCompile).configureEach {
+        kotlinOptions.jvmTarget = "17"
+    }
+}
diff --git a/Musicgo-main/android/gradle.properties b/Musicgo-main/android/gradle.properties
index 9fb1566..cd810f0 100644
--- a/Musicgo-main/android/gradle.properties
+++ b/Musicgo-main/android/gradle.properties
@@ -21,6 +21,7 @@ org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m
